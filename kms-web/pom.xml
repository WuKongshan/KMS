<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.kms</groupId>
        <artifactId>kms</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>kms-web</artifactId>
    <name>kms-web</name>
    <description>Web application (D): RuoYi-based UI - ops management, real-time charts, history, alerts, dashboard</description>

    <dependencies>
        <!-- Shared data-access layer -->
        <dependency>
            <groupId>com.kms</groupId>
            <artifactId>kms-database</artifactId>
        </dependency>

        <!-- Web application (RuoYi-style) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Login layer (option A): Spring Security provides the filter chain and
             BCrypt; JWT itself comes from kms-database (shared with the analyser) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- AOP: the operation-audit aspect (@OperLog) wraps annotated endpoints -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- WebSocket client-facing endpoint for alert push -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- Log viewer unit tests (whitelist / tail / keyword filtering) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- @WithMockUser / SecurityMockMvcRequestPostProcessors for authorization tests -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
