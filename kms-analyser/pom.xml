<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.kms</groupId>
        <artifactId>kms</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>kms-analyser</artifactId>
    <name>kms-analyser</name>
    <description>Analysis module (C): rule engine, 3-level alerts, dynamic thresholds, WebSocket push</description>

    <dependencies>
        <!-- Shared data-access layer -->
        <dependency>
            <groupId>com.kms</groupId>
            <artifactId>kms-database</artifactId>
        </dependency>

        <!-- WebSocket server: push alerts to the frontend in real time -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- JSON serialization of WebSocket alert payloads -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Rule engine unit tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
