<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.kms</groupId>
        <artifactId>kms</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>kms-collector</artifactId>
    <name>kms-collector</name>
    <description>Metric collection module (A): OSHI-based host metrics, dynamic period, REST control API</description>

    <dependencies>
        <!-- Shared data-access layer -->
        <dependency>
            <groupId>com.kms</groupId>
            <artifactId>kms-database</artifactId>
        </dependency>

        <!-- OSHI: read local CPU/memory/disk/network/temperature -->
        <dependency>
            <groupId>com.github.oshi</groupId>
            <artifactId>oshi-core</artifactId>
        </dependency>

        <!-- REST API for the web module to change period / enable-disable -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Swagger / OpenAPI 3：采集器自身的控制 API 也自动生成文档（:8081/swagger-ui/index.html）。
             注意采集器未接入鉴权（内部接口），部署时应限制来源，详见测试报告 SEC-01。 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
